{
  "name": "1inch",
  "version": "0.1.1",
  "description": "Find 1inch Business API documentation, SDK examples and public Aqua liquidity analytics.",
  "author": {
    "name": "NeuxBot contributors"
  },
  "repository": "https://business.1inch.com/portal/documentation/ai-integration/mcp-server",
  "license": "MIT",
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "extensions": {
    "com.openai": {
      "interface": {
