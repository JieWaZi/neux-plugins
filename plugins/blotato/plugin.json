{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "blotato",
  "version": "0.1.0",
  "description": "Review connected social channels and prepare content with Blotato.",
  "author": {
    "name": "NeuxBot contributors"
  },
  "repository": "https://www.blotato.com",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Blotato",
        "shortDescription": "Review connected social channels and prepare content with Blotato.",
        "developerName": "Blotato",
        "category": "automation",
        "websiteURL": "https://www.blotato.com",
        "supportURL": "https://www.blotato.com",
        "defaultPrompt": [
          "Show the resources available to me in Blotato without making changes."
        ],
        "logo": "./assets/icon.png",
        "composerIcon": "./assets/icon.png"
      }
    },
    "com.neuxbot": {
      "schemaVersion": 1,
      "presentation": ".neuxbot/presentation.json"
    }
  }
}
