{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "customerio",
  "version": "0.1.0",
  "description": "Review customer profiles and campaign information in Customer.io.",
  "author": {
    "name": "NeuxBot contributors"
  },
  "repository": "https://customer.io",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Customer.io",
        "shortDescription": "Review customer profiles and campaign information in Customer.io.",
        "developerName": "Customer.io",
        "category": "automation",
        "websiteURL": "https://customer.io",
        "supportURL": "https://customer.io",
        "defaultPrompt": [
          "Show the resources available to me in Customer.io without making changes."
        ],
        "logo": "./assets/icon.png",
        "composerIcon": "./assets/icon.png"
      }
    },
    "com.neuxbot": {
      "schemaVersion": 1,
      "presentation": ".neuxbot/presentation.json"
    }
  }
}
