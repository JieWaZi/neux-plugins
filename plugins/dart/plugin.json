{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "dart",
  "version": "0.1.0",
  "description": "Work with project tasks and team planning in Dart.",
  "author": {
    "name": "NeuxBot contributors"
  },
  "repository": "https://www.dartai.com",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Dart",
        "shortDescription": "Work with project tasks and team planning in Dart.",
        "developerName": "Dart",
        "category": "productivity",
        "websiteURL": "https://www.dartai.com",
        "supportURL": "https://www.dartai.com",
        "defaultPrompt": [
          "Show which resources I can access in Dart."
        ],
        "logo": "./assets/icon.png",
        "composerIcon": "./assets/icon.png"
      }
    },
    "com.neuxbot": {
      "schemaVersion": 1,
      "presentation": ".neuxbot/presentation.json"
    }
  }
}
