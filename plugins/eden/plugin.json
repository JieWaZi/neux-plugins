{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "eden",
  "version": "0.1.0",
  "description": "Research social content and review publishing activity in Eden.",
  "author": {
    "name": "NeuxBot contributors"
  },
  "repository": "https://eden.so",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "interface": {
