{
  "name": "feishu-office",
  "version": "0.1.0",
  "description": "Write Feishu documents, manage tables, schedule events and follow up on tasks.",
  "author": {
    "name": "NeuxAlly contributors"
  },
  "repository": "https://github.com/larksuite/cli",
  "license": "MIT",
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Feishu",
        "shortDescription": "Write Feishu documents, manage tables, schedule events and follow up on tasks.",
        "developerName": "飞书",
        "logo": "./assets/icon.png",
        "composerIcon": "./assets/icon.png",
        "brandColor": "#3370ff",
        "category": "Productivity",
        "defaultPrompt": [
          "Organize my meeting notes into a Feishu document with action items.",
          "Summarize the overdue tasks and project records I can access in Feishu."
        ],
        "capabilities": [
          "Read and write documents",
          "Manage tables and calendar events",
          "Track tasks and meeting notes"
        ],
        "websiteURL": "https://github.com/larksuite/cli",
        "supportURL": "https://github.com/larksuite/cli/issues"
      }
    },
    "com.neuxbot": {
      "schemaVersion": 1,
      "presentation": ".neuxbot/presentation.json",
      "authentication": {
        "strategy": "plugin-command",
        "protocol": "neuxbot-auth/1",
        "command": "node",
        "args": [
          "./.neuxbot/auth/authorize.mjs"
        ],
        "scopes": [
          "offline_access",
          "docx:document",
          "bitable:app",
          "calendar:calendar",
          "task:task:read",
          "task:task:write"
        ],
        "preferredAction": "show-qr",
        "skillBindings": [
