{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "kensho",
  "version": "0.1.0",
  "description": "Explore the financial research and company data available to your Kensho account.",
  "author": {
    "name": "NeuxBot contributors"
  },
  "repository": "https://kensho.com",
  "license": "MIT",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Kensho",
        "shortDescription": "Explore the financial research and company data available to your Kensho account.",
        "developerName": "Kensho Technologies",
        "category": "data-analytics",
        "websiteURL": "https://kensho.com",
        "supportURL": "https://kensho.com",
        "defaultPrompt": [
          "Show what information I can read in Kensho."
        ],
        "logo": "./assets/icon.png",
        "composerIcon": "./assets/icon.png"
      }
    },
    "com.neuxbot": {
      "schemaVersion": 1,
      "presentation": ".neuxbot/presentation.json"
    }
  }
}
