{
  "name": "wecom-office",
  "version": "0.1.1",
  "description": "Create WeCom documents, manage tables, arrange meetings and follow up on work.",
  "author": {
    "name": "NeuxBot contributors"
  },
  "repository": "https://github.com/WecomTeam/wecom-cli",
  "license": "MIT",
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "WeCom",
        "shortDescription": "Create WeCom documents, manage tables, arrange meetings and follow up on work.",
        "developerName": "企业微信",
        "logo": "./assets/icon.png",
        "composerIcon": "./assets/icon.png",
        "brandColor": "#2B7FFF",
        "category": "Productivity",
        "defaultPrompt": [
          "Organize a weekly project update from the WeCom documents and tasks I can access.",
          "Prepare a meeting agenda using the relevant WeCom documents and calendar."
        ],
        "capabilities": [
          "Work with documents and spreadsheets",
          "Arrange meetings and follow up tasks",
          "Search authorized files and contacts"
        ],
        "websiteURL": "https://github.com/WecomTeam/wecom-cli",
        "supportURL": "https://github.com/WecomTeam/wecom-cli/issues"
      }
    },
