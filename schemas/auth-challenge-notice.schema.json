{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JieWaZi/neux-plugins/schemas/auth-challenge-notice.schema.json",
  "title": "Optional current-challenge warning notice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messages"
  ],
  "properties": {
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 2,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00]+$",
          "description": "Plain text, valid UTF-8, nonempty and without NUL, at most 2048 UTF-8 bytes; byte length is additionally enforced by the bridge and host."
        },
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\x00]+$",
          "description": "Plain text, valid UTF-8, nonempty and without NUL, at most 2048 UTF-8 bytes; byte length is additionally enforced by the bridge and host."
        }
      }
    }
  }
}
