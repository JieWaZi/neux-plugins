{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JieWaZi/neux-plugins/schemas/details.schema.json",
  "title": "NeuxBot read-only standard plugin details",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceCommit",
    "archiveSHA256",
    "packagePath",
    "package",
    "readmes",
    "skillContents"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$"
    },
    "archiveSHA256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^plugins/[a-z0-9][a-z0-9-]*$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "format",
        "presentation",
        "upstream",
        "skills",
        "servers",
        "diagnostics",
        "contractVersion"
      ],
      "properties": {
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "description",
            "author",
            "keywords",
            "$schema"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "homepage": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "license": {
              "type": "string"
            },
            "author": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "$schema": {
              "const": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json"
            }
          }
        },
        "format": {
          "const": "agent-plugins"
        },
        "presentation": {
          "type": "object",
          "properties": {
            "displayName": {
              "type": "string",
              "maxLength": 4096
            },
            "shortDescription": {
              "type": "string",
              "maxLength": 4096
            },
            "longDescription": {
              "type": "string",
              "maxLength": 4096
            },
            "developerName": {
              "type": "string",
              "maxLength": 4096
            },
            "category": {
              "type": "string",
              "maxLength": 4096
            },
            "websiteURL": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "privacyPolicyURL": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "termsOfServiceURL": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "supportURL": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "maxItems": 64
            },
            "defaultPrompt": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "maxItems": 20
            },
            "brandColor": {
              "type": "object",
              "properties": {
                "default": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "dark": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "icons": {
              "type": "object",
              "properties": {
                "default": {
                  "type": "string",
                  "pattern": "^data:image/(?:png|jpeg|gif|svg\\+xml);base64,"
                },
                "dark": {
                  "type": "string",
                  "pattern": "^data:image/(?:png|jpeg|gif|svg\\+xml);base64,"
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "displayNames": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "maxLength": 4096
                },
                "zh-CN": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "localizedDescriptions": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "string",
                  "maxLength": 4096
                },
                "zh-CN": {
                  "type": "string",
                  "maxLength": 4096
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "defaultPromptLocalizations": {
              "type": "object",
              "properties": {
                "en": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "maxItems": 20
                },
                "zh-CN": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "maxItems": 20
                }
              },
              "required": [],
              "additionalProperties": false
            },
            "setup": {
              "type": "object",
              "properties": {
                "instructions": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "maxLength": 16384
                    },
                    "zh-CN": {
                      "type": "string",
                      "maxLength": 16384
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "helpURL": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "upstream": {
          "$ref": "provenance.schema.json#/properties/upstream"
        },
        "icon": {
          "type": "string",
          "pattern": "^data:image/png;base64,"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "name",
              "description",
              "path"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "type"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "streamable-http",
                  "sse",
                  "stdio"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https?://[^\\s]+$"
              },
              "authentication": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "none"
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "const": "api_key"
                      },
                      "headerScheme": {
                        "enum": [
                          "bearer",
                          "basic",
                          "custom_header"
                        ]
                      },
                      "headerName": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?![Hh][Oo][Ss][Tt]$)[!#$%&\\x27*+.^_`|~0-9A-Za-z-]+$"
                      }
                    },
                    "required": [
                      "type",
                      "headerScheme"
                    ],
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "headerScheme": {
                              "const": "custom_header"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "headerName"
                          ],
                          "properties": {
                            "headerName": {
                              "type": "string",
                              "minLength": 1,
                              "pattern": "^(?![Hh][Oo][Ss][Tt]$)[!#$%&\\x27*+.^_`|~0-9A-Za-z-]+$"
                            }
                          }
                        },
                        "else": {
                          "not": {
                            "required": [
                              "headerName"
                            ],
                            "properties": {
                              "headerName": {}
                            }
                          }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "integration": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "authentication": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "strategy": {
                  "type": "string"
                },
                "protocol": {
                  "type": "string"
                },
                "preferredAction": {
                  "type": "string"
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 0
        },
        "contractVersion": {
          "const": "neuxbot-plugin/1"
        }
      }
    },
    "readmes": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "en": {
          "type": "string"
        },
        "zh-CN": {
          "type": "string"
        }
      }
    },
    "skillContents": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[a-zA-Z0-9._/-]+$"
      }
    }
  }
}
