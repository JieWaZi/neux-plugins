{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JieWaZi/NeuxAlly-Plugins/schemas/neuxbot-extension.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "presentation": {
      "type": "string",
      "pattern": "^(?:\\./)?\\.neuxbot/[^\\\\:\\x00-\\x1f]+$"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "label": {
                "type": "string",
                "maxLength": 4096
              },
              "description": {
                "type": "string",
                "maxLength": 4096
              },
              "secret": {
                "type": "boolean"
              },
              "required": {
                "type": "boolean"
              },
              "default": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "key"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "secret": {
                      "const": true
                    }
                  },
                  "required": [
                    "secret"
                  ]
                },
                "then": {
                  "properties": {
                    "default": {
                      "const": ""
                    }
                  }
                }
              }
            ]
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "server": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "enum": [
                  "env",
                  "header"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "server",
              "target",
              "name",
              "value"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "target": {
                      "const": "env"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^(?![Hh][Oo][Ss][Tt]$)[!#$%&\\x27*+.^_`|~0-9A-Za-z-]+$"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "authentication": {
      "type": "object",
      "properties": {
        "strategy": {
          "const": "plugin-command"
        },
        "protocol": {
          "const": "neuxbot-auth/1"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 128
        },
        "preferredAction": {
          "enum": [
            "show-qr",
            "open-url"
          ]
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runtime": {
                "enum": [
                  "codex",
                  "claude"
                ]
              },
              "server": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "header": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![Hh][Oo][Ss][Tt]$)[!#$%&\\x27*+.^_`|~0-9A-Za-z-]+$"
              }
            },
            "required": [
              "runtime",
              "server",
              "url",
              "header"
            ],
            "additionalProperties": false
          }
        },
        "skillBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "runtime": {
                "enum": [
                  "codex",
                  "claude"
                ]
              },
              "skill": {
                "type": "string",
                "pattern": "^skills/[^/]+$"
              },
              "environmentKeys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "uniqueItems": true
              },
              "privatePathKeys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "runtime",
              "skill",
              "environmentKeys"
            ],
            "additionalProperties": false
          }
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 128
        }
      },
      "required": [
        "strategy",
        "protocol",
        "command"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion"
  ],
  "additionalProperties": false
}
