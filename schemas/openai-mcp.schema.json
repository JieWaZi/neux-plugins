{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JieWaZi/NeuxAlly-Plugins/schemas/openai-mcp.schema.json",
  "type": "object",
  "properties": {
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "none"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "api_key"
            },
            "headerScheme": {
              "enum": [
                "bearer",
                "basic",
                "custom_header"
              ]
            },
            "headerName": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?![Hh][Oo][Ss][Tt]$)[!#$%&\\x27*+.^_`|~0-9A-Za-z-]+$"
            }
          },
          "required": [
            "type",
            "headerScheme"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "headerScheme": {
                    "const": "custom_header"
                  }
                }
              },
              "then": {
                "required": [
                  "headerName"
                ],
                "properties": {
                  "headerName": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?![Hh][Oo][Ss][Tt]$)[!#$%&\\x27*+.^_`|~0-9A-Za-z-]+$"
                  }
                }
              },
              "else": {
                "not": {
                  "required": [
                    "headerName"
                  ],
                  "properties": {
                    "headerName": {}
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "oauth",
                "mixed"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        }
      ]
    }
  },
  "required": [],
  "additionalProperties": false
}
