{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JieWaZi/neux-plugins/schemas/provenance.schema.json",
  "title": "NeuxBot maintained plugin provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "upstream",
    "wrapper",
    "dependencies",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "author",
        "repository",
        "license",
        "distribution"
      ],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://[^\\s]+$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "vendored-source",
                "hosted-service"
              ]
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "pattern": "^https://[^\\s]+$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "distribution": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "vendored-source"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "commit"
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "distribution": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "hosted-service"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "distribution": {
                "type": "object",
                "required": [
                  "url"
                ]
              },
              "commit": false,
              "tag": false,
              "version": false
            }
          }
        }
      ]
    },
    "wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintainer",
        "repository",
        "license",
        "changes"
      ],
      "properties": {
        "maintainer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://[^\\s]+$"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[\\x20-\\x7e]+$"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "repository",
          "commit",
          "version",
          "license",
          "lock"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://[^\\s]+$"
          },
          "commit": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{40}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "lock": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[a-zA-Z0-9._/-]+$"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sourceURL",
          "sha256",
          "license",
          "attribution"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])[a-zA-Z0-9._/-]+$"
          },
          "sourceURL": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://[^\\s]+$"
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "sourceSHA256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[0-9a-f]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "licenseURL": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://[^\\s]+$"
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          }
        }
      }
    }
  }
}
